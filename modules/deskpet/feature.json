{
  "manifestVersion": "1.0.0",
  "name": "DeskPet",
  "displayName": "桌宠",
  "version": "1.0.0",
  "description": "助手的桌面形象（Live2D、精灵图或立绘）：显示回复和工具进度、朗读、闲时搭话，也能在桌面上批准工具调用。",
  "pluginType": "feature",
  "main": "index.js",
  "renderer": "DeskPetmodules/mainWindow/index.js",
  "schemes": [
    { "scheme": "vcp-deskpet", "privileges": { "standard": true, "secure": true, "supportFetchAPI": true } }
  ],
  "scripts": {
    "install": ["scripts/deskpet/fetch-cubism-core.cjs"],
    "package": ["scripts/deskpet/fetch-cubism-core.cjs", "--strict"]
  },
  "tests": [
    "tests/deskpet-wake.test.mjs",
    "tests/deskpet-session-card.test.mjs",
    "tests/deskpet-voice-session.test.mjs",
    "tests/deskpet-assets.test.mjs",
    "tests/deskpet-stream.test.mjs",
    "tests/deskpet-bubble-text.test.mjs",
    "tests/deskpet-lifecycle.test.mjs",
    "tests/deskpet-send-bridge.test.mjs",
    "tests/deskpet-life.test.mjs",
    "tests/deskpet-tool-activity.test.mjs",
    "tests/deskpet-proactive.test.mjs",
    "tests/deskpet-controls.test.mjs",
    "tests/deskpet-mood-order.test.mjs",
    "tests/deskpet-speech-text.test.mjs",
    "tests/deskpet-voice.test.mjs",
    "tests/deskpet-voice-ipc.test.mjs",
    "tests/deskpet-outfits.test.mjs",
    "tests/deskpet-gaze.test.mjs",
    "tests/deskpet-builtin-nova.test.mjs",
    "tests/deskpet-dictation.test.mjs",
    "tests/deskpet-cubism-core.test.mjs",
    "tests/deskpet-expression-map.test.mjs",
    "tests/deskpet-gestures.test.mjs",
    "tests/deskpet-fullscreen.test.mjs",
    "tests/deskpet-edge-snap.test.mjs",
    "tests/deskpet-hit-areas.test.mjs",
    "tests/deskpet-missed-reply.test.mjs",
    "tests/deskpet-attachments.test.mjs",
    "tests/deskpet-throw.test.mjs",
    "tests/deskpet-wander.test.mjs",
    "tests/deskpet-approvals.test.mjs",
    "tests/deskpet-zip-import.test.mjs",
    "tests/deskpet-idle-frames.test.mjs",
    "tests/deskpet-state.test.mjs",
    "tests/deskpet-backends.test.mjs",
    "tests/deskpet-drop-import.test.mjs",
    "tests/deskpet-head-pose.test.mjs",
    "tests/deskpet-idle-chat-ipc.test.mjs",
    "tests/deskpet-idle-chat.test.mjs",
    "tests/deskpet-codex-sprite.test.mjs"
  ],
  "defaultEnabled": true
}
