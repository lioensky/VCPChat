{
  "name": "vcp-chat-desktop",
  "version": "1.0.0",
  "description": "一个为VCP服务器打造的AI聊天桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "doctor": "node scripts/vcpchat-doctor.mjs",
    "start:managed": "node scripts/vcpchat-dev-launcher.mjs",
    "vcpchat": "node scripts/vcpchat.mjs",
    "vcpchat:ui": "node scripts/vcpchat-recovery-ui.mjs",
    "bootstrap": "node scripts/vcpchat-bootstrap.mjs",
    "repair:managed": "node scripts/vcpchat-repair.mjs",
    "start:recovery": "node scripts/vcpchat-recovery-ui.mjs",
    "installer:dev": "npm --prefix apps/bootstrap-installer run tauri:dev",
    "installer:typecheck": "npm --prefix apps/bootstrap-installer run typecheck",
    "installer:build": "npm --prefix apps/bootstrap-installer run tauri:build",
    "installer:portable": "node scripts/package-portable-installer.mjs",
    "check:release-surface": "node scripts/check-release-surface.mjs",
    "test:installer-contract": "node --test tests/vcpchat-installer-contract.test.mjs tests/vcpchat-installer-git-update.test.mjs",
    "verify:runtime-closure": "node scripts/vcpchat-runtime-closure.mjs --json",
    "test:packed-install": "node scripts/vcpchat-packed-smoke.mjs",
    "update:managed": "node scripts/vcpchat-update.mjs",
    "evidence:managed": "node scripts/vcpchat-release-evidence.mjs",
    "start:desktop": "electron . --desktop-only",
    "start:rag-observer": "electron . --rag-observer-only",
    "build": "node rust_chat_data_service/build-runtime.js",
    "lint:ui-system": "stylelint \"styles/ui-system/**/*.css\" --config stylelint.ui-system.config.cjs",
    "guard:design-subtraction": "node scripts/check-design-system-boundary.mjs",
    "guard:classic-parity": "node scripts/check-classic-parity.mjs",
    "guard:classic-retirement": "node scripts/check-classic-retirement-boundary.mjs",
    "guard:next-delta": "node scripts/check-next-delta-contract.mjs",
    "guard:chat-kernel-consumers": "node scripts/check-chat-kernel-consumers.mjs",
    "build:chat-event-graph": "node scripts/build-chat-event-graph.mjs",
    "check:chat-contracts": "node scripts/check-chat-contracts.mjs",
    "test:chat-contract-invariants": "node scripts/run-chat-contract-invariants.mjs && node scripts/test-chat-contract-invalid.mjs",
    "check:artifact-plane": "node scripts/check-artifact-plane.mjs",
    "test:built-artifact-smoke": "node scripts/test-built-artifact-smoke.mjs",
    "test:chat-transcript-snapshot": "node scripts/test-chat-transcript-snapshot.mjs",
    "check:chat-evidence": "node scripts/check-chat-evidence.mjs",
    "check:chat-release-evidence": "node scripts/check-chat-release-evidence.mjs",
    "write:chat-evidence-manifest": "node scripts/write-chat-evidence-manifest.mjs",
    "test:chat-evidence-manifest": "node scripts/test-chat-evidence-manifest.mjs",
    "test:facade-registry-invalid": "node scripts/test-facade-registry-invalid.mjs",
    "test:artifact-plane-invalid": "node scripts/test-artifact-plane-invalid.mjs",
    "test:packaged-artifact-smoke": "node scripts/test-packaged-artifact-smoke.mjs",
    "test:packaged-artifact-invalid": "node scripts/test-packaged-artifact-invalid.mjs",
    "guard:ui-system": "node scripts/check-ui-system.mjs && node scripts/check-vcpui-consumers.mjs",
    "check:ui-applications": "node scripts/check-ui-applications.mjs && node scripts/test-page-runtime.mjs",
    "pack:check": "npm run vendor:webawesome:check && node scripts/check-webawesome-pack.mjs",
    "vendor:webawesome:report": "node scripts/build-webawesome-runtime.mjs",
    "vendor:webawesome:check": "node scripts/build-webawesome-runtime.mjs --check vendor/webawesome-runtime",
    "test:ui-system": "node scripts/test-ui-system.mjs && node --test tests/performance-recorder.test.js tests/embedded-app-security.test.js tests/overlay-coordinator.test.js tests/embedded-app-controller.test.js tests/app-tab-host.test.js tests/assistant-search-controller.test.js tests/account-menu-controller.test.js tests/escape-dispatcher.test.js tests/notification-menu-controller.test.js tests/launchpad-controller.test.js tests/creation-controller.test.js tests/global-settings-save.test.mjs tests/task-handle.test.js tests/sender-task-registry.test.js tests/contribution-registry.test.js tests/state-channel.test.js tests/state-authority.test.js tests/settlement.test.js tests/surface-controller.test.js tests/lifecycle-inspector.test.js tests/main-chat-sequence-model.test.js tests/chat-manager-selection-race.test.js tests/history-watcher-lease-manager.test.js tests/message-edit-watcher-failure.test.js tests/stream-manager-terminal-cleanup.test.js tests/theme-handlers.test.js",
    "test:bootstrap": "node --test tests/vcpchat-bootstrap.test.mjs tests/vcpchat-managed-bootstrap-m3-m8.test.mjs tests/vcpchat-platform-boundary.test.mjs",
    "test:next-ui-empty-state": "node scripts/test-next-ui-empty-state.mjs",
    "test:ui-motion-contract": "node scripts/test-ui-motion-contract.mjs",
    "check:ui-system": "npm run guard:design-subtraction && npm run guard:classic-parity && npm run guard:classic-retirement && npm run guard:next-delta && npm run guard:ui-interaction && npm run guard:ui-async-state && npm run guard:ui-task-journeys && npm run guard:theme-provenance && npm run test:ui-motion-contract && node --check modules/ui-system/lifecycle-scope.js && node --check VCPDistributedServer/frontend-plugin-loader.js && node --check modules/ui-system/component-manifest.js && node --check modules/ui-system/vcp-ui.js && node --check modules/ui-system/webawesome-runtime-manifest.js && node --check modules/ui-system/webawesome-adapter.js && node --check modules/ui-system/appearance-engine.js && node --check modules/ui-system/appearance-studio.js && node --check modules/ui-system/next-ui-apps.js && node --check modules/ui-system/component-showcase.js && node --check modules/ui-system/webawesome-comparison.js && node --check modules/topTabManager.js && npm run lint:ui-system && npm run guard:ui-system && npm run check:ui-applications && npm run test:ui-system && npm run test:appearance-engine && npm run test:appearance-studio && node scripts/test-next-ui-tab-lifecycle.mjs && node scripts/test-webawesome-adapter.mjs && node --test tests/lifecycle-scope.test.js tests/next-ui-registries.test.mjs tests/topic-list-mode-lifecycle.test.js && npm run test:bootstrap",
    "test:appearance-engine": "node scripts/test-appearance-engine.mjs",
    "test:appearance-studio": "node scripts/test-appearance-studio.mjs",
    "test:vcp-ui-select-proxy": "node scripts/test-vcp-ui-select-proxy.mjs",
    "test:electron-ui-apps": "node scripts/test-electron-ui-apps-smoke.mjs",
    "test:electron-lifecycle-stress": "node scripts/test-electron-lifecycle-stress.mjs",
    "test:electron-main-chat-sequences": "node scripts/test-electron-main-chat-sequences.mjs",
    "test:windows-matrix": "node scripts/test-electron-windows-matrix.mjs",
    "test:manual-soak": "node scripts/test-electron-manual-soak.mjs",
    "test:electron-stability": "npm run test:electron-ui-apps && npm run test:electron-main-chat-sequences && npm run test:electron-lifecycle-stress",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:mobile-sync": "node --test tests/mobile-sync-protocol.test.js tests/mobile-sync-error-contract.test.js tests/mobile-sync-central-adapter.test.js tests/mobile-sync-canonical.test.js tests/mobile-sync-failure-contract.test.js tests/mobile-sync-streaming.test.js tests/mobile-sync-package.test.js",
    "test:cds": "cargo test --manifest-path rust_chat_data_service/Cargo.toml --locked",
    "check:cds:fmt": "cargo fmt --manifest-path rust_chat_data_service/Cargo.toml -- --check",
    "check:cds:clippy": "cargo clippy --manifest-path rust_chat_data_service/Cargo.toml --locked --all-targets -- -D warnings"
  },
  "keywords": [
    "VCP",
    "AI",
    "Chat",
    "Desktop",
    "Electron"
  ],
  "author": "莱恩 (由小吉辅助生成)",
  "license": "CC BY-NC-SA 4.0",
  "devDependencies": {
    "@awesome.me/webawesome": "3.11.0",
    "@electron/rebuild": "^4.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.0.12",
    "node-addon-api": "^8.3.1",
    "node-gyp": "^11.4.2"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@chenglou/pretext": "^0.0.7",
    "@xterm/headless": "^6.0.0",
    "animejs": "^4.0.2",
    "axios": "^1.10.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.1.2",
    "child_process": "^1.0.2",
    "chokidar": "^4.0.3",
    "clientside-search": "^1.8.1",
    "clipboard-event": "^1.6.0",
    "codemirror": "^5.65.19",
    "css-tree": "^3.2.1",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "flexsearch": "^0.8.212",
    "fs-extra": "^11.3.2",
    "glob": "^10.0.0",
    "hnswlib-node": "^3.0.0",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.6.3",
    "jsdom": "^27.0.1",
    "jszip": "^3.10.1",
    "lucide": "^1.25.0",
    "mammoth": "^1.9.1",
    "marked": "^12.0.0",
    "minimatch": "^9.0.0",
    "morphdom": "^2.7.7",
    "music-metadata": "^11.4.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0-beta37",
    "node-schedule": "^2.1.1",
    "os": "^0.1.2",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.1",
    "portfinder": "^1.0.37",
    "puppeteer": "^24.15.0",
    "sharp": "^0.35.3",
    "stylelint": "^16.25.0",
    "superdoc": "^1.45.0",
    "tesseract.js": "^6.0.1",
    "three": "^0.178.0",
    "tmp": "^0.2.5",
    "trash": "^9.0.0",
    "turndown": "^7.2.1",
    "ws": "^8.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "electron-edge-js": "^38.0.0"
  },
  "build": {
    "appId": "com.vcp.chatdesktop",
    "productName": "VCP聊天客户端",
    "asarUnpack": [
      "modules/services/chatDataService/bin/**/*",
      "audio_engine/**/*",
      "rust_assistant_engine/runtime/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "preloads/**/*",
      "renderer.js",
      "main.html",
      "bootstrap/**/*",
      "audio_engine/**/*",
      "image-viewer.html",
      "text-viewer.html",
      "style.css",
      "styles/**/*",
      "VCPDistributedServer/VCPDistributedServer.js",
      "VCPDistributedServer/Plugin.js",
      "VCPDistributedServer/frontend-plugin-loader.js",
      "VCPDistributedServer/Plugin/VCPMobileSync/**/*",
      "VCPDistributedServer/Plugin/VChatDynamicWallpaper/**/*",
      "VCPDistributedServer/Plugin/VChatAutoTTS/**/*",
      "assets/",
      "modules/**/*",
      "Groupmodules/**/*",
      "Flowlockmodules/**/*",
      "Promptmodules/**/*",
      "ScriptoriumModules/**/*",
      "Tavernmodules/**/*",
      "rust_assistant_engine/ui/**/*",
      "rust_assistant_engine/runtime/**/*",
      "Notemodules/**/*",
      "Translatormodules/**/*",
      "vendor/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "afterPack": "scripts/electron-builder-bootstrap-hooks.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets"
    }
  }
}
