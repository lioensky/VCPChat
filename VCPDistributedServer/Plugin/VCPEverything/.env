# Configuration for LocalSearchController Plugin

# --- Paths ---
# Absolute path to the Everything command-line interface (es.exe).
# Please use double backslashes (\\) for paths on Windows.
EVERYTHING_ES_PATH="E:\\everything\\app\\Everything\\es.exe"
EVERYTHING_PORT=8025
# --- Behavior ---
# Enable debug mode for more verbose logging to stderr. (true/false)
DEBUG_MODE="true"
