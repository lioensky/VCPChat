# VCPEverything / LocalSearchController
# 双源聚合：Windows 走 Everything HTTP，Linux/macOS 走 fd-rdd HTTP。
# 两个源可同时开启并发查询，也可只开其一；都关闭会直接报错。

# ---------- 搜索源开关 ----------
ENABLE_EVERYTHING=true
ENABLE_FD_RDD=true

# ---------- Everything HTTP（Windows 常用）----------
# 需在 Everything → 工具 → 选项 → HTTP 服务器 中启用，端口与下方一致
EVERYTHING_HOST=127.0.0.1
EVERYTHING_PORT=80

# ---------- fd-rdd HTTP（Linux / macOS 常用）----------
# 需先运行 fd-rdd 服务并暴露 HTTP 查询端点，默认端口 6060
# 示例启动：fd-rdd --listen 127.0.0.1:6060
FD_RDD_HOST=127.0.0.1
FD_RDD_PORT=6060
FD_RDD_PATH=/search

# ---------- 行为 ----------
# 单次查询超时（毫秒）
SEARCH_TIMEOUT_MS=5000
# 打印详细日志到 stderr
DEBUG_MODE=false
