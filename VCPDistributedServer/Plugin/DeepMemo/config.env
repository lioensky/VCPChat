# DeepMemo 2.0 默认消费 Electron 主进程持有的 VCP-CDS，不再自行扫描历史或创建索引。
DeepMemoBackend=central
DeepMemoLegacyFallback=False
DeepMemoExcludeCurrentTopic=True
DeepMemoCandidateLimit=50
DeepMemoResultLimit=8
DeepMemoTimeoutMs=30000
MaxMemoTokens=60000
QueryPreset=

# 临时回滚：
# DeepMemoLegacyFallback=True 仅在中央搜索失败时启动旧 deepmemo_rust.exe。
# DeepMemoBackend=legacy 会强制使用旧实现，不建议长期启用。
