# DeepMemo 2.0 使用 Electron 主进程持有的 VCP-CDS。
DeepMemoBackend=central
DeepMemoLegacyFallback=False
DeepMemoExcludeCurrentTopic=True
DeepMemoCandidateLimit=50
DeepMemoResultLimit=8
DeepMemoTimeoutMs=30000
# MaxMemoTokens 是最终输出给模型的最大字符数。
MaxMemoTokens=60000

# DeepMemo JS 并发 Rerank；关闭时直接使用 CDS/Tantivy 排名。
RerankSearch=True
RerankUrl=http://your-rerank-api-endpoint/
RerankApi=sk-your-api-key-here
RerankModel=Qwen/Qwen3-Reranker-8B
# CDS 返回最终数量的 3 倍窗口作为精排池。
RerankCandidateMultiplier=3
# 每个 API 请求最多 25 个文档。
RerankMaxDocumentsPerBatch=25
# 模型标称 64K；保守使用 60000 预留 tokenizer 和请求包装空间。
RerankMaxTokensPerBatch=60000
RerankTimeoutMs=30000

# --- 全局查询预设 (Query Preset) ---
# 在这里设置一个“默认查询”，它会自动附加到每一次AI搜索请求的后面。
# 这对于全局性地调整搜索行为非常有用，类似Stable Diffusion的“质量提示词”。
# 关键词使用,隔开。
# 支持以下高级语法:
#   - 普通词:           VCP
#   - 精确短语:         "VCP服务器"
#   - 正向加权 (0.0-2.0): (重要概念:1.5)
#   - 负向排除 :         [闲聊] //不支持权重
#   - OR 逻辑:          {破解|渗透|测试} //支持正向权重
#
# 示例: 假设我们希望所有搜索都更关注技术性内容，同时排除日常闲聊和特定项目。
# 查询预设: [闲聊],[日常对话],(技术:1.2),(代码:1.1),{bug|修复|问题:1.3}
QueryPreset=