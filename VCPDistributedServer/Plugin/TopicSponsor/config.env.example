# Copy to this plugin directory's config.env, then reload/restart the plugin service.
# Default: deliver replies only. Only the literal true (case-insensitive) enables advancement.
REPLY_ADVANCE_ENABLED=false
# Optional request-only invitation for single chat; blank uses the frontend default.
# Does not enter history, affect group speaker selection, or create a Flowlock session.
REPLY_INVITE_PROMPT=