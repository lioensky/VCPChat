# FileOperator Plugin Configuration
# =========================================================
# Copy this file to config.env (or .env) and modify as needed.
# Priority: config.env > .env > code defaults.

# Security Settings - Define allowed directories for file operations
# Use absolute paths, separated by commas.
# Leave empty to allow all directories (NOT RECOMMENDED for production).
ALLOWED_DIRECTORIES=

# Default download directory for DownloadFile operations.
# If not specified, defaults to AppData/file directory relative to the plugin.
DEFAULT_DOWNLOAD_DIR=

# Maximum file size for operations (in bytes)
# 10MB = 10485760, 20MB = 20971520, 50MB = 52428800
MAX_FILE_SIZE=20971520

# Maximum number of items returned in directory listings
MAX_DIRECTORY_ITEMS=1000

# Maximum number of search results
MAX_SEARCH_RESULTS=100

# Enable debug logging (true/false)
DEBUG_MODE=false

# File operation settings
ENABLE_RECURSIVE_OPERATIONS=true
ENABLE_HIDDEN_FILES=false

# Base path for resolving bare relative paths (e.g. "Plugin/foo/bar")
# Defaults to two levels up from this plugin's directory (i.e. VCPChat root)
# BASE_PATH=

# Backup settings (optional)
# CREATE_BACKUPS=false
# BACKUP_DIRECTORY=